# Root-readable only. Do not bake into the image.
ALKAID_HTTP_ADDR=0.0.0.0:8022
ALKAID_GRPC_ADDR=0.0.0.0:9022
# 多副本控制面用逗号分隔；Kubernetes 内建议写无头 Service。
ALKAID_ALIOTH_GRPC_ADDR=alioth:9000
ALKAID_AGENT_TOKEN=ag-replace-me

# 可选：SSH 主机密钥校验文件（known_hosts 格式）。生产建议配置。
# ALKAID_SSH_KNOWN_HOSTS=/etc/alioth/known_hosts

# 可选：alioth gRPC 的 TLS/mTLS。配置 CA 后启用；同时配置 CERT/KEY 时带客户端证书。
# ALKAID_ALIOTH_TLS_CA=/etc/alioth/ca.crt
# ALKAID_ALIOTH_TLS_CERT=/etc/alioth/alkaid.crt
# ALKAID_ALIOTH_TLS_KEY=/etc/alioth/alkaid.key
# ALKAID_ALIOTH_TLS_SERVER_NAME=alioth-headless
